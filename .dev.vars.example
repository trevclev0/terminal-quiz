CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>
ENVIRONMENT="development"

BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=<YOUR_BETTER_AUTH_SECRET>
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>

# Optional daily AI clue budget (UTC). Defaults to 150 in code when unset.
# AI_DAILY_CLUE_BUDGET=150

# Auth test bypass — only enable in CI/preview environments with a dedicated
# test secret, not for general preview/staging deployments.
# AUTH_TEST_BYPASS_ENABLED=true
AUTH_TEST_BYPASS_SECRET=e2e-test-secret
