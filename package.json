{
  "name": "terminal-quiz",
  "private": true,
  "version": "2.88.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:code": "biome check --write .",
    "check": "bun run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "bun run seed:e2e:local && playwright test",
    "schema:generate": "bun run scripts/dump-schema.ts",
    "gql:generate": "graphql-codegen --config codegen.yml",
    "seed:generate": "bun run scripts/seed.ts && bun run scripts/seed-e2e.ts",
    "seed:e2e:local": "bun run seed:generate && wrangler d1 execute terminal-quest --local --file=scripts/generated/seed-e2e.sql",
    "seed:e2e:preview": "bun run seed:generate && wrangler d1 execute terminal-quest-preview --remote --env preview --file=scripts/generated/seed-e2e.sql",
    "build": "tsc -b && vite build",
    "preview": "bun run build && vite preview",
    "commit": "git-cz",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "seed:local": "bun run seed:generate && wrangler d1 execute terminal-quest --local --file=scripts/generated/seed.sql",
    "seed:preview": "bun run seed:generate && wrangler d1 execute terminal-quest-preview --remote --env preview --file=scripts/generated/seed.sql",
    "seed:prod": "bun run seed:generate && wrangler d1 execute terminal-quest --remote --file=scripts/generated/seed.sql",
    "migrate:generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply terminal-quest --local",
    "migrate:preview": "wrangler d1 migrations apply terminal-quest-preview --remote --env preview",
    "migrate:prod": "wrangler d1 migrations apply terminal-quest --remote",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.62.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "msw": "^2.14.6",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@hono/graphql-server": "^0.7.0",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "better-auth": "^1.7.2",
    "drizzle-graphql": "^0.8.5",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "hono": "4.13.5",
    "leven": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "overrides": {
    "graphql": "^17.0.2",
    "hono": "4.12.34"
  }
}
