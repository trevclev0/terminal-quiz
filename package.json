{
  "name": "terminal-quiz",
  "private": true,
  "version": "2.62.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:code": "biome check --write .",
    "check": "bun run build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "bun run seed:e2e:local && playwright test",
    "seed:e2e:local": "wrangler d1 execute terminal-quest --local --file=scripts/seed-e2e.sql",
    "seed:e2e:preview": "wrangler d1 execute terminal-quest-preview --remote --env preview --file=scripts/seed-e2e.sql",
    "build": "tsc -b && vite build",
    "preview": "bun run build && vite preview",
    "commit": "git-cz",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "seed:local": "wrangler d1 execute terminal-quest --local --file=scripts/seed.sql",
    "seed:preview": "wrangler d1 execute terminal-quest-preview --remote --env preview --file=scripts/seed.sql",
    "seed:prod": "wrangler d1 execute terminal-quest --remote --file=scripts/seed.sql",
    "migrate:generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply terminal-quest --local",
    "migrate:preview": "wrangler d1 migrations apply terminal-quest-preview --remote --env preview",
    "migrate:prod": "wrangler d1 migrations apply terminal-quest --remote",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.6.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "msw": "^2.14.6",
    "semantic-release": "^25.0.8",
    "semantic-release-gitmoji": "^1.6.9",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@hono/graphql-server": "^0.7.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "better-auth": "^1.6.25",
    "drizzle-graphql": "^0.8.5",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "hono": "4.12.28",
    "leven": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "graphql": "^17.0.2",
    "hono": "4.12.28"
  }
}
